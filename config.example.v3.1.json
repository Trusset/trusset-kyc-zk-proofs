{
  "mapping": {
    "fields": [
      "firstName",
      "lastName",
      "dateOfBirth",
      "nationality",
      "documentType",
      "documentNumber",
      "documentIssuingCountry"
    ],
    "walletAddressField": "walletAddress",
    "countryField": "country",
    "investorTypeField": "investorType",
    "softExpiryDaysField": "softExpiryDays",
    "hardExpiryDaysField": "hardExpiryDays",
    "evidenceDateField": "evidenceDate"
  },
  "claims": {
    "defaults": {
      "issuingParty": "self",
      "evidenceClass": "DOCUMENTARY",
      "validity": {
        "days": 365,
        "basisAsOfOffsetDays": 0
      }
    }
  },
  "predicates": {
    "dateOfBirth": {
      "circuit": "age_threshold",
      "params": {
        "minAgeYears": 18
      },
      "descriptor": {
        "legalBasis": {
          "framework": "NATIONAL",
          "reference": "contractual capacity, age of majority",
          "assertion": "Subject is at or above the age of majority"
        },
        "evidenceClass": "DOCUMENTARY"
      },
      "validity": {
        "days": 3650
      },
      "predicate": "ADULT"
    },
    "country": [
      {
        "circuit": "set_membership",
        "params": {
          "list": "eea"
        },
        "predicate": "EEA_RESIDENT",
        "optional": true,
        "descriptor": {
          "legalBasis": {
            "framework": "EEA_AGREEMENT",
            "reference": "Art. 31, right of establishment",
            "assertion": "Subject residence is in an EEA member state"
          },
          "evidenceClass": "DOCUMENTARY"
        },
        "validity": {
          "days": 365
        }
      },
      {
        "circuit": "set_membership",
        "params": {
          "list": "country_allowlist"
        },
        "descriptor": {
          "legalBasis": {
            "framework": "AMLD5",
            "reference": "Art. 9, high-risk third countries",
            "assertion": "Subject residence is in a jurisdiction on the approved list"
          },
          "evidenceClass": "DOCUMENTARY"
        },
        "validity": {
          "days": 365
        },
        "predicate": "RESIDENCY_ON_FILE"
      }
    ],
    "nationality": {
      "circuit": "set_membership",
      "params": {
        "list": "country_allowlist"
      },
      "descriptor": {
        "legalBasis": {
          "framework": "AMLD5",
          "reference": "Art. 13(1)(a), customer identification",
          "assertion": "Subject nationality is in a jurisdiction on the approved list"
        },
        "evidenceClass": "DOCUMENTARY"
      },
      "validity": {
        "days": 365
      },
      "predicate": "CITIZENSHIP_ON_FILE"
    },
    "documentIssuingCountry": {
      "circuit": "set_membership",
      "params": {
        "list": "country_allowlist"
      },
      "descriptor": {
        "legalBasis": {
          "framework": "AMLD5",
          "reference": "Art. 13(1)(a), customer identification",
          "assertion": "Identity document was issued by a jurisdiction on the approved list"
        },
        "evidenceClass": "DOCUMENTARY"
      },
      "validity": {
        "days": 365
      }
    },
    "investorType": {
      "circuit": "tier_threshold",
      "params": {
        "minTier": "ATTESTED"
      },
      "descriptor": {
        "legalBasis": {
          "framework": "MiFID_II",
          "reference": "Annex II, client categorisation",
          "assertion": "Subject is categorised in the attested client class"
        },
        "evidenceClass": "DOCUMENTARY"
      },
      "validity": {
        "days": 730
      },
      "predicate": "INVESTOR_CLASS"
    },
    "firstName": {
      "circuit": "commitment_only",
      "params": {
        "maxValueBytes": 128
      },
      "descriptor": {
        "legalBasis": {
          "framework": "AMLD5",
          "reference": "Art. 13(1)(a), customer identification",
          "assertion": "Subject given name as recorded at onboarding"
        },
        "evidenceClass": "DOCUMENTARY"
      },
      "validity": {
        "days": 365
      }
    },
    "lastName": {
      "circuit": "commitment_only",
      "params": {
        "maxValueBytes": 128
      },
      "descriptor": {
        "legalBasis": {
          "framework": "AMLD5",
          "reference": "Art. 13(1)(a), customer identification",
          "assertion": "Subject family name as recorded at onboarding"
        },
        "evidenceClass": "DOCUMENTARY"
      },
      "validity": {
        "days": 365
      }
    },
    "documentType": {
      "circuit": "commitment_only",
      "params": {
        "maxValueBytes": 64
      },
      "descriptor": {
        "legalBasis": {
          "framework": "AMLD5",
          "reference": "Art. 13(1)(a), customer identification",
          "assertion": "Class of identity document examined"
        },
        "evidenceClass": "DOCUMENTARY"
      },
      "validity": {
        "days": 365
      }
    },
    "documentNumber": {
      "circuit": "commitment_only",
      "params": {
        "maxValueBytes": 64
      },
      "descriptor": {
        "legalBasis": {
          "framework": "AMLD5",
          "reference": "Art. 13(1)(a), customer identification",
          "assertion": "Identifier of the identity document examined"
        },
        "evidenceClass": "DOCUMENTARY"
      },
      "validity": {
        "days": 365
      }
    }
  },
  "tiers": {
    "NONE": 0,
    "RETAIL": 1,
    "PROFESSIONAL": 2,
    "ELIGIBLE_COUNTERPARTY": 3
  },
  "lists": {
    "country_allowlist": {},
    "eea": {}
  },
  "output": {
    "format": "csv",
    "includeIndex": true,
    "bundleDir": "output",
    "emitIndexCsv": true,
    "defaults": {
      "investorType": "RETAIL",
      "softExpiryDays": 365,
      "hardExpiryDays": 730
    }
  },
  "security": {
    "clearInputAfterProcessing": true,
    "masterKeyEnv": "TRUSSET_KYC_MASTER_KEY",
    "epochDaysSource": "fixed:20776",
    "deterministic": true,
    "registryDir": "config/registry",
    "keyStore": {
      "type": "file",
      "path": ".trusset/operator.key"
    }
  },
  "manifest": {
    "signingKeyEnv": "TRUSSET_KYC_SIGNING_KEY",
    "version": "3.1.0",
    "issuer": {
      "name": "Example Bank AG",
      "identifierScheme": "LEI",
      "identifier": "529900T8BM49AURSDO55",
      "jurisdiction": "DE",
      "keyId": "issuing-2026-11"
    }
  },
  "chain": {
    "chainId": 11155111,
    "hub": "0xYOUR_IDENTITY_HUB_ADDRESS",
    "attester": "0xYOUR_ATTESTER_WALLET",
    "keyId": 1
  }
}
